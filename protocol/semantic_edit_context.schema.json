{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_edit_context/1",
  "title": "Context agent → Editor_Writer agent handoff",
  "type": "object",
  "required": [
    "schema", "document", "user_feedback", "semantic_structure", "semantic_relations",
    "diagnosis", "repair_intent", "preservation_constraints", "editor_authority", "priority"
  ],
  "$defs": {
    "unitId": { "type": "string", "minLength": 1 },
    "location": {
      "type": "array",
      "items": { "$ref": "#/$defs/unitId" },
      "minItems": 1
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "severity": { "type": "string", "pattern": "^P[0-9]$" },
    "finding": {
      "type": "object",
      "required": ["type", "location", "meaning", "severity", "confidence"],
      "properties": {
        "type": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "meaning": { "type": "string" },
        "severity": { "$ref": "#/$defs/severity" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "operation": {
      "enum": [
        "reorder", "merge", "split", "remove_redundancy", "clarify_reference",
        "add_transition", "rephrase", "change_paragraph_boundary",
        "invent_fact", "invent_experience", "invent_result", "invent_motivation",
        "change_claim", "change_user_intent"
      ]
    }
  },
  "properties": {
    "schema": { "const": "semantic_edit_context/1" },
    "document": {
      "type": "object",
      "required": ["id", "purpose", "target", "original_text"],
      "properties": {
        "id": { "type": "string" },
        "purpose": { "type": "string" },
        "target": { "type": "string" },
        "original_text": { "type": "string" }
      }
    },
    "user_feedback": {
      "type": "object",
      "required": ["raw", "intent"],
      "properties": {
        "raw": { "type": "string" },
        "intent": {
          "type": "object",
          "required": ["type", "meaning", "confidence"],
          "properties": {
            "type": { "type": "string" },
            "meaning": { "type": "string" },
            "confidence": { "$ref": "#/$defs/confidence" }
          }
        }
      }
    },
    "semantic_structure": {
      "type": "object",
      "required": ["thesis", "units"],
      "properties": {
        "thesis": {
          "type": "object",
          "required": ["id", "meaning"],
          "properties": {
            "id": { "type": "string" },
            "meaning": { "type": "string" }
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "role", "meaning"],
            "properties": {
              "id": { "$ref": "#/$defs/unitId" },
              "role": { "type": "string" },
              "meaning": { "type": "string" }
            }
          }
        }
      }
    },
    "semantic_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation", "expected", "observed", "status", "confidence"],
        "properties": {
          "from": { "$ref": "#/$defs/unitId" },
          "to": { "$ref": "#/$defs/unitId" },
          "relation": { "type": "string" },
          "expected": { "type": "string" },
          "observed": { "type": "string" },
          "status": { "type": "string", "description": "e.g. broken | weak | missing" },
          "confidence": { "$ref": "#/$defs/confidence" }
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "$ref": "#/$defs/finding" },
        "secondary": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "repair_intent": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location", "goal", "semantic_operation"],
        "properties": {
          "location": { "$ref": "#/$defs/location" },
          "goal": { "type": "string" },
          "semantic_operation": { "type": "string", "description": "e.g. connect | sequence | bridge" },
          "preserve": { "type": "array", "items": { "type": "string" } },
          "forbid": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "preservation_constraints": {
      "type": "object",
      "required": ["facts", "experiences", "achievements", "intent", "voice", "meaning", "style"],
      "properties": {
        "facts": { "type": "string" },
        "experiences": { "type": "string" },
        "achievements": { "type": "string" },
        "intent": { "type": "string" },
        "voice": { "type": "string" },
        "meaning": { "type": "string" },
        "style": { "type": "string" }
      }
    },
    "editor_authority": {
      "type": "object",
      "required": ["allowed", "not_allowed"],
      "properties": {
        "allowed": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/operation" } },
        "not_allowed": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/operation" } }
      }
    },
    "priority": {
      "type": "object",
      "required": ["strategy", "max_major_repairs", "avoid_overediting"],
      "properties": {
        "strategy": { "type": "string" },
        "max_major_repairs": { "type": "integer", "minimum": 1 },
        "avoid_overediting": { "type": "boolean" }
      }
    }
  }
}
